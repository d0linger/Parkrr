  "lang": "de",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0C1312",
  "theme_color": "#0F7A73",
