# Copy this file to .env and adjust the values before running docker compose.

# --- HTTP ---
# Host port the app is published on.
PARKRR_HTTP_PORT=8080

# --- Database (Postgres container) ---
PARKRR_DB_USER=parkrr
PARKRR_DB_PASSWORD=change-me-db-password
PARKRR_DB_NAME=parkrr

# --- Admin bootstrap ---
# This account is created/refreshed on every startup from these values.
PARKRR_ADMIN_USERNAME=admin
PARKRR_ADMIN_EMAIL=admin@example.com
PARKRR_ADMIN_PASSWORD=change-me-admin-password

# --- Security ---
# Long random string used to sign/secure sessions (min. 16 chars).
# Generate e.g. with: openssl rand -base64 48
PARKRR_SESSION_SECRET=change-me-to-a-long-random-secret-string

# Secure flag on cookies. Secure-by-default (true): the flag is always applied,
# which is correct behind TLS or a trusted proxy (X-Forwarded-Proto=https).
# Browsers still send Secure cookies on http://localhost (a trusted context),
# so local development works. Set to false ONLY when serving dev/test over
# plain HTTP on a non-localhost host (e.g. a LAN IP).
PARKRR_SECURE_COOKIES=true

# --- Reverse proxy (e.g. Nginx Proxy Manager, Traefik, Caddy) ---
# Enable ONLY when the app runs behind a trusted reverse proxy. It then trusts
# X-Forwarded-For / X-Real-IP (client IP for logs, rate limiting, audit) and
# X-Forwarded-Proto (HTTPS detection for Secure cookies and HSTS).
# Leave false for direct exposure to avoid header spoofing.
PARKRR_TRUSTED_PROXY=false

# General per-IP request budget per minute (0 disables it). Login has its own
# stricter lockout on top of this.
PARKRR_RATE_LIMIT_PER_MIN=600

# --- Logging ---
# json (default) or text; level: debug|info|warn|error.
PARKRR_LOG_FORMAT=json
PARKRR_LOG_LEVEL=info

# Optional build metadata.
PARKRR_VERSION=dev
