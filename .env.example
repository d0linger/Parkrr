# Copy this file to .env for `docker compose`, OR paste it into Portainer:
#   Stack → Environment variables → Advanced mode.
# Every value line is a plain KEY=value with no inline comment, so it pastes
# cleanly. Change at least PARKRR_ADMIN_PASSWORD, PARKRR_SESSION_SECRET and
# PARKRR_DB_PASSWORD before deploying.

# --- HTTP ---
# Host port the app is published on.
PARKRR_HTTP_PORT=8080

# --- Container image (GHCR / Portainer compose only) ---
# Pin a released version instead of latest, e.g. PARKRR_TAG=1.2
PARKRR_TAG=latest
# PARKRR_IMAGE=d0linger/parkrr

# --- Database (bundled Postgres container) ---
PARKRR_DB_USER=parkrr
PARKRR_DB_PASSWORD=change-me-db-password
PARKRR_DB_NAME=parkrr
PARKRR_DB_SSLMODE=disable
# For an EXTERNAL database instead of the bundled one, set the full URL below
# (it overrides the PARKRR_DB_* values above):
# PARKRR_DATABASE_URL=postgres://user:pass@host:5432/parkrr?sslmode=require

# --- Admin bootstrap ---
# This account is created/refreshed on every startup from these values.
PARKRR_ADMIN_USERNAME=admin
PARKRR_ADMIN_EMAIL=admin@example.com
PARKRR_ADMIN_PASSWORD=change-me-admin-password

# --- Security ---
# Long random string used to sign/secure sessions (min. 32 bytes; enforced).
# Generate e.g. with: openssl rand -base64 48
PARKRR_SESSION_SECRET=change-me-to-a-long-random-secret-string

# Secure flag on cookies. Secure-by-default (true): correct behind TLS or a
# trusted proxy. Browsers still send Secure cookies on http://localhost, so
# local dev works. Set false ONLY for plain-HTTP dev on a non-localhost host.
PARKRR_SECURE_COOKIES=true

# Session lifetime in seconds. sliding=false (default): absolute — you re-login
# SESSION_MAX_AGE after login regardless of activity. sliding=true: re-login only
# after that much inactivity, capped by ABSOLUTE_MAX_AGE.
PARKRR_SESSION_MAX_AGE=604800
PARKRR_SESSION_SLIDING=false
PARKRR_SESSION_ABSOLUTE_MAX_AGE=7776000

# Check new passwords against Have I Been Pwned (k-anonymity; fail-open).
PARKRR_CHECK_BREACHED_PASSWORDS=true

# --- Passkeys (WebAuthn) ---
# Passwordless, phishing-resistant login. Enabled only when RP_ID is set.
# RP_ID = the site's registrable domain (no scheme/port); ORIGINS = the exact
# origin(s) users visit. Requires HTTPS (http://localhost also works for dev).
# Example:
#   PARKRR_WEBAUTHN_RP_ID=parkrr.example.com
#   PARKRR_WEBAUTHN_ORIGINS=https://parkrr.example.com
PARKRR_WEBAUTHN_RP_ID=
PARKRR_WEBAUTHN_RP_NAME=Parkrr
PARKRR_WEBAUTHN_ORIGINS=

# --- Reverse proxy (Nginx Proxy Manager, Traefik, Caddy) ---
# Enable ONLY behind a trusted reverse proxy. It then trusts X-Forwarded-For /
# X-Real-IP (client IP for logs, rate limiting, audit) and X-Forwarded-Proto
# (HTTPS detection for Secure cookies + HSTS). Leave false for direct exposure.
PARKRR_TRUSTED_PROXY=false

# --- Ops ---
# General per-IP request budget per minute (0 disables it).
PARKRR_RATE_LIMIT_PER_MIN=600
# Prune audit-log entries older than N days (0 = keep forever).
PARKRR_AUDIT_RETENTION_DAYS=365
# Bearer token required to scrape GET /metrics (empty = open on internal net).
PARKRR_METRICS_TOKEN=
PARKRR_LOG_FORMAT=json
PARKRR_LOG_LEVEL=info

# --- Build metadata (local build only) ---
PARKRR_VERSION=dev
